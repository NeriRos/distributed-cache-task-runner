{
  "name": "dcache",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/dcache/src",
  "projectType": "application",
  "tags": ["scope:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/dcache"],
      "options": {
        "command": "tsc -p apps/dcache/tsconfig.app.json --outDir dist/apps/dcache"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/dcache/tsconfig.app.json --noEmit"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/dcache/**/*.ts"]
      }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/dcache"],
      "dependsOn": ["^build"],
      "options": {
        "command": "npx tsx apps/dcache/esbuild.config.ts"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "dependsOn": ["bundle"],
      "options": {
        "commands": [
          "cp apps/dcache/package.json dist/apps/dcache/package.json",
          "cp apps/dcache/README.md dist/apps/dcache/README.md",
          "cd dist/apps/dcache && npm publish --access public"
        ],
        "parallel": false
      }
    }
  }
}
