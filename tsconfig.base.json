{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@dcache/cache": [
        "libs/cache/src/index.ts"
      ],
      "@dcache/cli": [
        "libs/cli/src/index.ts"
      ],
      "@dcache/config": [
        "libs/config/src/index.ts"
      ],
      "@dcache/hasher": [
        "libs/hasher/src/index.ts"
      ],
      "@dcache/nx-integration": [
        "libs/nx-integration/src/index.ts"
      ],
      "@dcache/runner": [
        "libs/runner/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "tmp"
  ]
}
